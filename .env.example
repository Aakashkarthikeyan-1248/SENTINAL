# SENTINAL Configuration

# --- Gemini API (Optional, Fallback rule-based summarizer provided if not set) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase Backend Configuration ---
# Leave empty to default to local SQLite (sentinal.db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- Event Detection Thresholds ---
# Time in seconds an item must be isolated to flag an incident
UNATTENDED_TIME_THRESHOLD_SEC=5.0
# Pixel distance threshold between item center and nearest person
PROXIMITY_PIXEL_THRESHOLD=150.0
